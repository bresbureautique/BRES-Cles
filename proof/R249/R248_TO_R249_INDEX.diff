+function diagnosticPublicationContextIdentityR249(payload){
+ const seal=payload&&payload.contextSealR173;
+ const series=payload&&payload.captureSeries;
+ return {
+  schema:"bres-ocr-diagnostic-publication-context-binding-r249-v1",
+  contextSealSchema:seal&&seal.schema?String(seal.schema):null,
+  identificationEpoch:Number(seal&&seal.identificationEpoch),
+  mainPhotoEpoch:Number(seal&&seal.mainPhotoEpoch),
+  ocrCaptureCycleEpoch:Number(seal&&seal.ocrCaptureCycleEpoch),
+  localTemplateEpoch:Number(seal&&seal.localTemplateEpoch),
+  captureSeriesActive:!!(seal&&seal.captureSeriesActive),
+  captureSeriesId:Number(seal&&seal.captureSeriesId)||0,
+  captureSeriesPayloadId:Number(series&&series.seriesId)||0,
+  signatureFingerprint:String((seal&&seal.signatureFingerprint)||""),
+  preflightReceiptSchemaR247:String((payload&&payload.diagnosticPublicationPreflightR247&&payload.diagnosticPublicationPreflightR247.schema)||""),
+  decisionInfluence:false
+ };
+}
+function bindDiagnosticPublicationContextR249(payload){
+ return diagnosticPublicationContextIdentityR249(payload);
+}
+function diagnosticPublicationContextBindingIntegrityR249(payload){
+ const expected=diagnosticPublicationContextIdentityR249(payload),receipt=payload&&payload.diagnosticPublicationContextBindingR249,errors=[];
+ const finiteFields=["identificationEpoch","mainPhotoEpoch","ocrCaptureCycleEpoch","localTemplateEpoch"];
+ if(!receipt||typeof receipt!=="object")errors.push("publication-context-binding-missing");
+ else{
+  if(receipt.schema!==expected.schema)errors.push("publication-context-binding-schema-mismatch");
+  if(receipt.contextSealSchema!==expected.contextSealSchema)errors.push("publication-context-seal-schema-mismatch");
+  for(const key of finiteFields){
+   if(!Number.isFinite(expected[key])||Number(receipt[key])!==expected[key])errors.push("publication-context-"+key+"-mismatch");
+  }
+  if(!!receipt.captureSeriesActive!==expected.captureSeriesActive)errors.push("publication-context-series-active-mismatch");
+  if(Number(receipt.captureSeriesId||0)!==expected.captureSeriesId)errors.push("publication-context-series-id-mismatch");
+  if(Number(receipt.captureSeriesPayloadId||0)!==expected.captureSeriesPayloadId)errors.push("publication-context-series-payload-id-mismatch");
+  if(String(receipt.signatureFingerprint||"")!==expected.signatureFingerprint)errors.push("publication-context-signature-mismatch");
+  if(String(receipt.preflightReceiptSchemaR247||"")!==expected.preflightReceiptSchemaR247)errors.push("publication-context-preflight-schema-mismatch");
+  if(receipt.decisionInfluence!==false)errors.push("publication-context-decision-influence-invalid");
+ }
+ return {schema:"bres-ocr-diagnostic-publication-context-binding-integrity-r249-v1",ok:errors.length===0,errors,expected:{...expected},decisionInfluence:false};
+}
+function blockInvalidDiagnosticPublicationContextBindingR249(bindingIntegrity){
+ const errors=(bindingIntegrity&&Array.isArray(bindingIntegrity.errors)&&bindingIntegrity.errors.length)?[...bindingIntegrity.errors]:["publication-context-binding-invalid"];
+ const blocked=invalidateOCRDiagnosticSnapshotR245({errors});
+ return {...blocked,publicationContextBindingIntegrityR249:bindingIntegrity,decisionInfluence:false};
+}
