{
  "schema": "bres-live-discriminant-collection-protocol-r124-v1",
  "milestone": "BRES Cles catalogue audit R124",
  "active_test_runtime": "V2.28 TEST R116",
  "inherits_contract": "bres-live-discriminant-evidence-contract-r123-v1",
  "purpose": "Prepare a repeatable physical collection protocol for future stop/shoulder and independent recto-verso evidence without changing recognition thresholds or decision authority.",
  "policy": {
    "runtime_r116_remains_unchanged": true,
    "catalogue_remains_canonical_and_unchanged": true,
    "collection_does_not_activate_evidence": true,
    "collected_records_default_evidence_status": "MEASURED_UNVALIDATED",
    "collected_records_default_policy_status": "A_CONFIRMER",
    "decision_authority": "NONE",
    "no_acceptance_threshold_is_authorized": true,
    "no_automatic_validation_from_collection": true
  },
  "repeatability_plan": {
    "minimum_independent_sessions_per_physical_key": 3,
    "minimum_recto_captures_per_session": 1,
    "minimum_verso_captures_per_session": 1,
    "session_ids_must_be_distinct": true,
    "recto_and_verso_capture_ids_must_be_distinct": true,
    "repeat_sessions_should_not_reuse_capture_ids": true
  },
  "gabarit_control": {
    "required_scale_checks_mm": [50, 100],
    "record_measured_scale_values": true,
    "record_gabarit_id_and_version": true,
    "record_zero_mode": true,
    "permitted_zero_modes": ["POINTE_ZERO", "BUTEE_ZERO", "UNKNOWN"],
    "automatic_tolerance_or_pass_fail_rule": null
  },
  "capture_provenance": {
    "required_fields": ["capture_session_id", "captured_at", "device_model", "side", "capture_id", "source_file_sha256", "gabarit.id", "gabarit.version"],
    "permitted_sides": ["RECTO", "VERSO"],
    "record_lighting_notes": true,
    "record_alignment_notes": true,
    "record_focus_notes": true
  },
  "measurement_recording": {
    "stop_or_shoulder": {
      "record_position_mm": true,
      "record_uncertainty_mm": true,
      "record_measurement_method": true,
      "status_after_collection": "MEASURED_UNVALIDATED"
    },
    "dual_face": {
      "record_recto_geometry_signature": true,
      "record_verso_geometry_signature": true,
      "require_independent_capture_ids": true,
      "record_measurement_method": true,
      "status_after_collection": "MEASURED_UNVALIDATED"
    }
  },
  "review_before_any_future_activation": ["physical_capture_validation", "repeatability_evidence", "uncertainty_characterization", "explicit_non_regression_guard", "separate_policy_change"]
}
