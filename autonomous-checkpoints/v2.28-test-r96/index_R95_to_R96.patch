+function catalogVisualFingerprint(cat){
+  if(!cat)return "";
+  const c=cat.sig||cat;
+  return JSON.stringify({width_mm:c.width_mm,height_mm:c.height_mm,area:c.area,bladeFill:c.bladeFill,top:c.top,bot:c.bot});
+}
+function catalogueVisualAmbiguityGroup(canon){
+  const base=catalogVisualEntry(canon); if(!base)return [];
+  const fp=catalogVisualFingerprint(base),maker=String(XREF[canon]?.Pour||"").toUpperCase();
+  return Object.keys(XREF).filter(ref=>{
+    if(String(XREF[ref]?.Pour||"").toUpperCase()!==maker)return false;
+    const cat=catalogVisualEntry(ref);
+    return cat&&catalogVisualFingerprint(cat)===fp;
+  });
+}
+function brandVisualCandidates(info){
+  if(!currentSig||!info||info.crossViewConflict)return [];
+  const maker=resolvedOCRBrand(info); if(!maker)return [];
+  const upper=maker.toUpperCase(),out=[];
+  for(const canon of Object.keys(XREF)){
+    const pour=String(XREF[canon]?.Pour||"").toUpperCase();
+    if(pour!==upper)continue;
+    const cat=catalogVisualEntry(canon); if(!cat)continue;
+    const check=catalogVisualScore(currentSig,cat);
+    out.push({canon,score:check.score,silca:cat.silca,ambiguity:catalogueVisualAmbiguityGroup(canon)});
+  }
+  out.sort((a,b)=>b.score-a.score||a.canon.localeCompare(b.canon));
+  return out;
+}
