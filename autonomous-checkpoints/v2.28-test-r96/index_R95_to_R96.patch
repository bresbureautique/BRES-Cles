+function headFocusBoundsFromGray(gray,w,h){
+  // R96 : cherche l'objet qui occupe une grande hauteur dans plusieurs colonnes.
+  // Une règle horizontale produit beaucoup de pixels sombres mais une faible hauteur par colonne ;
+  // la tête de clé produit au contraire un grand intervalle vertical et doit donc gagner.
+  if(!gray||w<8||h<8||gray.length<w*h)return {x:0,y:0,w,h,confidence:0};
+  const span=new Array(w).fill(0), darkThreshold=118, maxVerticalGap=Math.max(1,Math.round(h*.018));
+  for(let x=0;x<w;x++){
+    let bestRun=0,runStart=-1,lastDark=-999;
+    for(let y=0;y<h;y++){
+      if(gray[y*w+x]<darkThreshold){
+        if(runStart<0 || y-lastDark>maxVerticalGap+1)runStart=y;
+        lastDark=y;bestRun=Math.max(bestRun,lastDark-runStart+1);
+      }
+    }
+    span[x]=bestRun;
+  }
+  const radius=Math.max(1,Math.round(w*.018)), smooth=new Array(w).fill(0);
+  for(let x=0;x<w;x++){
+    let sum=0,n=0;
+    for(let j=Math.max(0,x-radius);j<=Math.min(w-1,x+radius);j++){sum+=span[j];n++;}
+    smooth[x]=n?sum/n:0;
+  }
+  const maxSpan=Math.max(...smooth), threshold=Math.max(h*.28,maxSpan*.56);
+  const maxGap=Math.max(2,Math.round(w*.34));
+  let runs=[],start=-1,lastActive=-1;
+  for(let x=0;x<w;x++){
+    if(smooth[x]>=threshold){if(start<0)start=x;lastActive=x;}
+    else if(start>=0 && x-lastActive>maxGap){runs.push([start,lastActive]);start=-1;lastActive=-1;}
+  }
+  if(start>=0)runs.push([start,lastActive]);
+  if(!runs.length)return {x:Math.round(w*.10),y:Math.round(h*.02),w:Math.round(w*.80),h:Math.round(h*.96),confidence:0};
+  let best=null;
+  for(const [a,b] of runs){
+    let energy=0;for(let x=a;x<=b;x++)energy+=smooth[x];
+    const width=b-a+1,score=energy*(1+Math.min(.8,width/Math.max(1,w)*1.6));
+    if(!best||score>best.score)best={a,b,width,score};
+  }
+  const padX=Math.round(w*.075);
+  let x0=Math.max(0,best.a-padX),x1=Math.min(w-1,best.b+padX);
+  const ys=[];
+  for(let x=x0;x<=x1;x++)for(let y=0;y<h;y++)if(gray[y*w+x]<darkThreshold)ys.push(y);
+  ys.sort((a,b)=>a-b);
+  let y0=Math.round(h*.03),y1=Math.round(h*.97);
+  if(ys.length){
+    y0=ys[Math.floor(ys.length*.02)]??y0;y1=ys[Math.floor(ys.length*.98)]??y1;
+    const padY=Math.round(h*.055);y0=Math.max(0,y0-padY);y1=Math.min(h-1,y1+padY);
+  }
+  const outW=Math.max(1,x1-x0+1),outH=Math.max(1,y1-y0+1);
+  const confidence=Math.max(0,Math.min(1,(maxSpan/Math.max(1,h))*(best.width/Math.max(1,w))/.20));
+  return {x:x0,y:y0,w:outW,h:outH,confidence};
+}
+function autoFocusHeadCanvas(src){
+  try{
+    const w=src.width,h=src.height,ctx=src.getContext("2d"),im=ctx.getImageData(0,0,w,h),d=im.data;
+    const gray=new Uint8Array(w*h);
+    for(let i=0,j=0;i<d.length;i+=4,j++)gray[j]=Math.round(.299*d[i]+.587*d[i+1]+.114*d[i+2]);
+    const b=headFocusBoundsFromGray(gray,w,h);
+    return cropCanvas(src,b.x,b.y,b.w,b.h,b.confidence>=.18?3.1:2.7);
+  }catch(e){
+    return cropCanvas(src,src.width*.12,src.height*.03,src.width*.84,src.height*.92,2.7);
+  }
+}
