+    const bin=BigInt('0x'+s).toString(2).padStart(128,'0');
+    const rows=[];for(let y=0;y<8;y++)rows.push([...bin.slice(y*16,(y+1)*16)].map(x=>x==='1'?1:0));
+    return rows;
+  }
+  function profileSvg(hex,label){
+    const b=profileBits(hex);if(!b)return '';
